# Getrennte Codes – jede kommt nur in ihren eigenen Bereich (per Link /login?code=... oder eintippen)
# Die beiden Codes müssen unterschiedlich sein!
OMA_CODE=oma-sonnenblume
PFLEGE_CODE=pflege-apfelbaum
# Passwort für /admin
ADMIN_PASSWORD=bitte-aendern
# Beliebiger langer Zufallstext zum Signieren der Login-Cookies
AUTH_SECRET=hier-einen-langen-zufallstext-eintragen

# Datenbank: Upstash Redis (Vercel -> Storage -> Upstash for Redis). Wird von Vercel automatisch gesetzt.
# Lokal ohne diese Variablen wird in .data/db.json gespeichert.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Optional: bessere Übersetzung (DeepL Free, 500.000 Zeichen/Monat kostenlos)
# DEEPL_API_KEY=

# Optional: deutlich bessere Kassenzettel-Erkennung per Claude (kostenpflichtig, ca. 1 Cent pro Zettel)
# Ohne Key läuft die Erkennung kostenlos direkt im Handy (Tesseract).
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
